{
  "name": "supabase",
  "version": "0.1.0",
  "description": "Query tables, manage auth, inspect storage buckets on Supabase projects.",
  "author": {
    "name": "Fleetify",
    "url": "https://github.com/fleetify"
  },
  "providers": [
    "claude",
    "codex",
    "gemini"
  ],
  "tags": [
    "infrastructure",
    "data"
  ],
  "icon": "https://cdn.jsdelivr.net/gh/simple-icons/simple-icons@latest/icons/supabase.svg",
  "requires_secrets": [
    {
      "key": "SUPABASE_URL",
      "label": "Project URL"
    },
    {
      "key": "SUPABASE_KEY",
      "label": "Service role key",
      "url": "https://supabase.com/dashboard/project/_/settings/api"
    }
  ],
  "declares": {
    "mcp_servers": 1,
    "skills": 0,
    "templates": 0,
    "commands": 0,
    "hooks": 0,
    "workflows": 0
  },
  "license": "MIT"
}
