{
  "name": "supabase",
  "display_name": "Supabase",
  "version": "0.1.1",
  "description": "Query tables, manage auth, inspect storage buckets on Supabase projects.",
  "author": {
    "name": "Fleetify",
    "url": "https://github.com/fleetifydev"
  },
  "providers": [
    "claude-code",
    "codex-cli",
    "gemini-cli",
    "opencode",
    "cursor-cli",
    "hermes-agent",
    "github-copilot",
    "antigravity-cli",
    "antigravity-sdk",
    "grok-build"
  ],
  "tags": [
    "infrastructure",
    "data"
  ],
  "icon": "https://api.iconify.design/logos:supabase-icon.svg",
  "requires_secrets": [
    {
      "key": "SUPABASE_URL",
      "label": "Project URL"
    },
    {
      "key": "SUPABASE_KEY",
      "label": "Service role key",
      "url": "https://supabase.com/dashboard/project/_/settings/api"
    }
  ],
  "declares": {
    "mcp_servers": 1,
    "templates": 0,
    "workflows": 0,
    "prompts": 0,
    "providers": {}
  },
  "homepage": "https://github.com/fleetifydev/marketplace/tree/main/supabase",
  "license": "MIT"
}
