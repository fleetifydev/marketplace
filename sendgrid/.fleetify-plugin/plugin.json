{
  "name": "sendgrid",
  "display_name": "SendGrid",
  "version": "0.1.2",
  "description": "Send transactional + marketing email via SendGrid.",
  "author": {
    "name": "Fleetify",
    "url": "https://github.com/fleetifydev"
  },
  "providers": [
    "claude-code",
    "codex-cli",
    "opencode",
    "cursor-cli",
    "hermes-agent",
    "github-copilot",
    "antigravity-cli",
    "antigravity-sdk",
    "grok-build"
  ],
  "tags": [
    "infrastructure"
  ],
  "icon": "https://api.iconify.design/logos:sendgrid-icon.svg",
  "requires_secrets": [
    {
      "key": "SENDGRID_API_KEY",
      "label": "SendGrid API key",
      "url": "https://app.sendgrid.com/settings/api_keys"
    }
  ],
  "declares": {
    "mcp_servers": 1,
    "templates": 0,
    "workflows": 0,
    "prompts": 0,
    "providers": {}
  },
  "homepage": "https://github.com/fleetifydev/marketplace/tree/main/sendgrid",
  "license": "MIT"
}
