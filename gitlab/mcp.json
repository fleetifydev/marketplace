{
  "mcpServers": {
    "gitlab": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-gitlab"
      ],
      "env": {
        "GITLAB_PERSONAL_ACCESS_TOKEN": "${secret:GITLAB_PERSONAL_ACCESS_TOKEN}",
        "GITLAB_API_URL": "${secret:GITLAB_API_URL}"
      }
    }
  }
}
