{
  "name": "gitlab",
  "display_name": "GitLab",
  "version": "0.1.0",
  "description": "Read issues, MRs, pipelines, and code from GitLab projects.",
  "author": {
    "name": "Fleetify",
    "url": "https://github.com/fleetifydev"
  },
  "providers": [
    "claude",
    "codex",
    "gemini",
    "opencode",
    "cursor",
    "hermes",
    "github-copilot",
    "agy",
    "antigravity-sdk"
  ],
  "tags": [
    "productivity"
  ],
  "icon": "https://api.iconify.design/logos:gitlab.svg",
  "requires_secrets": [
    {
      "key": "GITLAB_PERSONAL_ACCESS_TOKEN",
      "label": "GitLab PAT"
    },
    {
      "key": "GITLAB_API_URL",
      "label": "GitLab instance URL (default https://gitlab.com/api/v4)"
    }
  ],
  "declares": {
    "mcp_servers": 1,
    "templates": 0,
    "workflows": 0,
    "prompts": 0,
    "providers": {}
  },
  "homepage": "https://github.com/fleetifydev/marketplace/tree/main/gitlab",
  "license": "MIT"
}
