{
  "name": "figma",
  "version": "0.1.0",
  "description": "Read frames, components, and design tokens from any Figma file.",
  "author": {
    "name": "Fleetify",
    "url": "https://github.com/fleetify"
  },
  "providers": [
    "claude",
    "codex",
    "gemini"
  ],
  "tags": [
    "productivity"
  ],
  "icon": "https://cdn.jsdelivr.net/gh/simple-icons/simple-icons@latest/icons/figma.svg",
  "requires_secrets": [
    {
      "key": "FIGMA_TOKEN",
      "label": "Figma personal access token",
      "url": "https://www.figma.com/developers/api#access-tokens"
    }
  ],
  "declares": {
    "mcp_servers": 1,
    "skills": 0,
    "templates": 0,
    "commands": 0,
    "hooks": 0,
    "workflows": 0
  },
  "license": "MIT"
}
