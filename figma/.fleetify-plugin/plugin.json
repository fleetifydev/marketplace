{
  "name": "figma",
  "display_name": "Figma",
  "version": "0.1.0",
  "description": "Read frames, components, and design tokens from any Figma file.",
  "author": {
    "name": "Fleetify",
    "url": "https://github.com/fleetifydev"
  },
  "providers": [
    "claude",
    "codex",
    "gemini",
    "opencode",
    "cursor",
    "hermes",
    "github-copilot",
    "agy",
    "antigravity-sdk"
  ],
  "tags": [
    "productivity"
  ],
  "icon": "https://api.iconify.design/logos:figma.svg",
  "requires_secrets": [
    {
      "key": "FIGMA_TOKEN",
      "label": "Figma personal access token",
      "url": "https://www.figma.com/developers/api#access-tokens"
    }
  ],
  "declares": {
    "mcp_servers": 1,
    "templates": 0,
    "workflows": 0,
    "prompts": 0,
    "providers": {}
  },
  "homepage": "https://github.com/fleetifydev/marketplace/tree/main/figma",
  "license": "MIT"
}
