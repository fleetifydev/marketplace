{
  "name": "aws",
  "display_name": "AWS",
  "version": "0.1.0",
  "description": "Inspect AWS resources — EC2, S3, Lambda, IAM — with read-only credentials.",
  "author": {
    "name": "Fleetify",
    "url": "https://github.com/fleetifydev"
  },
  "providers": [
    "claude-code",
    "codex-cli",
    "gemini-cli",
    "opencode",
    "cursor-cli",
    "hermes-agent",
    "github-copilot",
    "antigravity-cli",
    "antigravity-sdk"
  ],
  "tags": [
    "infrastructure"
  ],
  "icon": "https://api.iconify.design/logos:aws.svg",
  "requires_secrets": [
    {
      "key": "AWS_ACCESS_KEY_ID",
      "label": "AWS Access Key ID"
    },
    {
      "key": "AWS_SECRET_ACCESS_KEY",
      "label": "AWS Secret Access Key"
    },
    {
      "key": "AWS_REGION",
      "label": "Default region (e.g. us-east-1)"
    }
  ],
  "declares": {
    "mcp_servers": 1,
    "templates": 0,
    "workflows": 0,
    "prompts": 0,
    "providers": {}
  },
  "homepage": "https://github.com/fleetifydev/marketplace/tree/main/aws",
  "license": "MIT"
}
