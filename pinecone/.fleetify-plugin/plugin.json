{
  "name": "pinecone",
  "display_name": "Pinecone",
  "version": "0.1.1",
  "description": "Pinecone vector DB — query, upsert, manage indexes.",
  "author": {
    "name": "Fleetify",
    "url": "https://github.com/fleetifydev"
  },
  "providers": [
    "claude-code",
    "codex-cli",
    "gemini-cli",
    "opencode",
    "cursor-cli",
    "hermes-agent",
    "github-copilot",
    "antigravity-cli",
    "antigravity-sdk",
    "grok-build"
  ],
  "tags": [
    "data"
  ],
  "icon": "https://api.iconify.design/logos:pinecone.svg",
  "requires_secrets": [
    {
      "key": "PINECONE_API_KEY",
      "label": "Pinecone API key",
      "url": "https://app.pinecone.io"
    },
    {
      "key": "PINECONE_INDEX",
      "label": "Default index name"
    }
  ],
  "declares": {
    "mcp_servers": 1,
    "templates": 0,
    "workflows": 0,
    "prompts": 0,
    "providers": {}
  },
  "homepage": "https://github.com/fleetifydev/marketplace/tree/main/pinecone",
  "license": "MIT"
}
