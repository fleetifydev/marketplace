{
  "name": "slack",
  "display_name": "Slack",
  "version": "0.1.0",
  "description": "Read channel history, post messages, manage Slack from any agent.",
  "author": {
    "name": "Fleetify",
    "url": "https://github.com/fleetifydev"
  },
  "providers": [
    "claude-code",
    "codex-cli",
    "gemini-cli",
    "opencode",
    "cursor-cli",
    "hermes-agent",
    "github-copilot",
    "antigravity-cli",
    "antigravity-sdk"
  ],
  "tags": [
    "productivity"
  ],
  "icon": "https://api.iconify.design/logos:slack-icon.svg",
  "requires_secrets": [
    {
      "key": "SLACK_BOT_TOKEN",
      "label": "Slack Bot Token (xoxb-…)",
      "url": "https://api.slack.com/apps"
    },
    {
      "key": "SLACK_TEAM_ID",
      "label": "Slack Team ID (T…)",
      "url": "https://api.slack.com/methods/team.info"
    }
  ],
  "declares": {
    "mcp_servers": 1,
    "templates": 0,
    "workflows": 0,
    "prompts": 0,
    "providers": {}
  },
  "homepage": "https://github.com/fleetifydev/marketplace/tree/main/slack",
  "license": "MIT"
}
