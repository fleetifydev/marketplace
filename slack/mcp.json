{
  "mcpServers": {
    "slack": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-slack"
      ],
      "env": {
        "SLACK_BOT_TOKEN": "${secret:SLACK_BOT_TOKEN}",
        "SLACK_TEAM_ID": "${secret:SLACK_TEAM_ID}"
      }
    }
  }
}
