{
  "name": "slack",
  "version": "0.1.0",
  "description": "Read channel history, post messages, manage Slack from any agent.",
  "author": {
    "name": "Fleetify",
    "url": "https://github.com/fleetify"
  },
  "providers": [
    "claude",
    "codex",
    "gemini"
  ],
  "tags": [
    "productivity"
  ],
  "icon": "https://api.iconify.design/logos:slack-icon.svg",
  "requires_secrets": [
    {
      "key": "SLACK_BOT_TOKEN",
      "label": "Slack Bot Token (xoxb-\u2026)",
      "url": "https://api.slack.com/apps"
    },
    {
      "key": "SLACK_TEAM_ID",
      "label": "Slack Team ID (T\u2026)",
      "url": "https://api.slack.com/methods/team.info"
    }
  ],
  "declares": {
    "mcp_servers": 1,
    "skills": 0,
    "templates": 0,
    "commands": 0,
    "hooks": 0,
    "workflows": 0
  },
  "license": "MIT"
}
