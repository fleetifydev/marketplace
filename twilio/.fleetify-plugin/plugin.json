{
  "name": "twilio",
  "display_name": "Twilio",
  "version": "0.1.1",
  "description": "Send SMS, place voice calls, manage Twilio phone numbers.",
  "author": {
    "name": "Fleetify",
    "url": "https://github.com/fleetifydev"
  },
  "providers": [
    "claude-code",
    "codex-cli",
    "gemini-cli",
    "opencode",
    "cursor-cli",
    "hermes-agent",
    "github-copilot",
    "antigravity-cli",
    "antigravity-sdk",
    "grok-build"
  ],
  "tags": [
    "infrastructure"
  ],
  "icon": "https://api.iconify.design/logos:twilio-icon.svg",
  "requires_secrets": [
    {
      "key": "TWILIO_ACCOUNT_SID",
      "label": "Account SID"
    },
    {
      "key": "TWILIO_AUTH_TOKEN",
      "label": "Auth token"
    }
  ],
  "declares": {
    "mcp_servers": 1,
    "templates": 0,
    "workflows": 0,
    "prompts": 0,
    "providers": {}
  },
  "homepage": "https://github.com/fleetifydev/marketplace/tree/main/twilio",
  "license": "MIT"
}
