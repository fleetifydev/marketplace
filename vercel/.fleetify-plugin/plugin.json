{
  "name": "vercel",
  "display_name": "Vercel",
  "version": "0.1.0",
  "description": "List deployments, inspect builds, fetch logs from your Vercel projects.",
  "author": {
    "name": "Fleetify",
    "url": "https://github.com/fleetifydev"
  },
  "providers": [
    "claude",
    "codex",
    "gemini",
    "opencode",
    "cursor",
    "hermes",
    "github-copilot",
    "agy",
    "antigravity-sdk"
  ],
  "tags": [
    "infrastructure"
  ],
  "icon": "https://api.iconify.design/logos:vercel-icon.svg",
  "requires_secrets": [
    {
      "key": "VERCEL_TOKEN",
      "label": "Vercel API token",
      "url": "https://vercel.com/account/tokens"
    }
  ],
  "declares": {
    "mcp_servers": 1,
    "templates": 0,
    "workflows": 0,
    "prompts": 0,
    "providers": {}
  },
  "homepage": "https://github.com/fleetifydev/marketplace/tree/main/vercel",
  "license": "MIT"
}
