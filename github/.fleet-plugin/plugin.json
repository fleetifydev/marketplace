{
  "name": "github",
  "version": "0.1.0",
  "description": "Read issues, PRs, file contents, and search across any GitHub repo the agent has access to.",
  "author": {
    "name": "Fleetify",
    "url": "https://github.com/fleetify"
  },
  "providers": [
    "claude",
    "codex",
    "gemini"
  ],
  "tags": [
    "productivity",
    "infrastructure"
  ],
  "icon": "https://api.iconify.design/logos:github-icon.svg",
  "requires_secrets": [
    {
      "key": "GITHUB_TOKEN",
      "label": "GitHub Personal Access Token",
      "url": "https://github.com/settings/tokens"
    }
  ],
  "declares": {
    "mcp_servers": 1,
    "skills": 0,
    "templates": 0,
    "commands": 0,
    "hooks": 0,
    "workflows": 0
  },
  "license": "MIT"
}
