{
  "name": "github",
  "display_name": "GitHub",
  "version": "0.1.2",
  "description": "Read issues, PRs, file contents, and search across any GitHub repo the agent has access to.",
  "author": {
    "name": "Fleetify",
    "url": "https://github.com/fleetifydev"
  },
  "providers": [
    "claude-code",
    "codex-cli",
    "opencode",
    "cursor-cli",
    "hermes-agent",
    "github-copilot",
    "antigravity-cli",
    "antigravity-sdk",
    "grok-build"
  ],
  "tags": [
    "productivity",
    "infrastructure"
  ],
  "icon": "https://api.iconify.design/logos:github-icon.svg",
  "requires_secrets": [
    {
      "key": "GITHUB_TOKEN",
      "label": "GitHub Personal Access Token",
      "url": "https://github.com/settings/tokens"
    }
  ],
  "declares": {
    "mcp_servers": 1,
    "templates": 0,
    "workflows": 0,
    "prompts": 0,
    "providers": {}
  },
  "homepage": "https://github.com/fleetifydev/marketplace/tree/main/github",
  "license": "MIT"
}
