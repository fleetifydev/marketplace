{
  "mcpServers": {
    "jira": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "mcp-atlassian"
      ],
      "env": {
        "JIRA_URL": "https://${secret:JIRA_HOST}",
        "JIRA_USERNAME": "${secret:JIRA_EMAIL}",
        "JIRA_API_TOKEN": "${secret:JIRA_API_TOKEN}"
      }
    }
  }
}
