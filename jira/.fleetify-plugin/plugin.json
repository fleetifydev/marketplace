{
  "name": "jira",
  "display_name": "Jira",
  "version": "0.1.1",
  "description": "Read + update Jira tickets, sprints, and projects across Atlassian Cloud.",
  "author": {
    "name": "Fleetify",
    "url": "https://github.com/fleetifydev"
  },
  "providers": [
    "claude-code",
    "codex-cli",
    "gemini-cli",
    "opencode",
    "cursor-cli",
    "hermes-agent",
    "github-copilot",
    "antigravity-cli",
    "antigravity-sdk",
    "grok-build"
  ],
  "tags": [
    "productivity"
  ],
  "icon": "https://api.iconify.design/logos:jira.svg",
  "requires_secrets": [
    {
      "key": "JIRA_HOST",
      "label": "Jira host (your-domain.atlassian.net)"
    },
    {
      "key": "JIRA_EMAIL",
      "label": "Account email"
    },
    {
      "key": "JIRA_API_TOKEN",
      "label": "API token",
      "url": "https://id.atlassian.com/manage-profile/security/api-tokens"
    }
  ],
  "declares": {
    "mcp_servers": 1,
    "templates": 0,
    "workflows": 0,
    "prompts": 0,
    "providers": {}
  },
  "homepage": "https://github.com/fleetifydev/marketplace/tree/main/jira",
  "license": "MIT"
}
