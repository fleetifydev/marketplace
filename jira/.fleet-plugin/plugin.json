{
  "name": "jira",
  "version": "0.1.0",
  "description": "Read + update Jira tickets, sprints, and projects across Atlassian Cloud.",
  "author": {
    "name": "Fleetify",
    "url": "https://github.com/fleetify"
  },
  "providers": [
    "claude",
    "codex",
    "gemini"
  ],
  "tags": [
    "productivity"
  ],
  "icon": "https://cdn.jsdelivr.net/gh/simple-icons/simple-icons@latest/icons/jira.svg",
  "requires_secrets": [
    {
      "key": "JIRA_HOST",
      "label": "Jira host (your-domain.atlassian.net)"
    },
    {
      "key": "JIRA_EMAIL",
      "label": "Account email"
    },
    {
      "key": "JIRA_API_TOKEN",
      "label": "API token",
      "url": "https://id.atlassian.com/manage-profile/security/api-tokens"
    }
  ],
  "declares": {
    "mcp_servers": 1,
    "skills": 0,
    "templates": 0,
    "commands": 0,
    "hooks": 0,
    "workflows": 0
  },
  "license": "MIT"
}
