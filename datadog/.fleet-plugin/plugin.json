    },
    {
      "key": "DD_APP_KEY",
      "label": "Datadog Application key"
    },
    {
      "key": "DD_SITE",
      "label": "Datadog site (datadoghq.com / datadoghq.eu / \u2026)"
    }
  ],
  "declares": {
    "mcp_servers": 1,
