{
  "name": "datadog",
  "version": "0.1.0",
  "description": "Query metrics, search logs, browse dashboards from Datadog.",
  "author": {
    "name": "Fleetify",
    "url": "https://github.com/fleetify"
  },
  "providers": [
    "claude",
    "codex",
    "gemini"
  ],
  "tags": [
    "data",
    "infrastructure"
  ],
  "icon": "https://cdn.jsdelivr.net/gh/simple-icons/simple-icons@latest/icons/datadog.svg",
  "requires_secrets": [
    {
      "key": "DD_API_KEY",
