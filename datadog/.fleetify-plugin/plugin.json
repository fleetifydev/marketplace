{
  "name": "datadog",
  "display_name": "Datadog",
  "version": "0.1.0",
  "description": "Query metrics, search logs, browse dashboards from Datadog.",
  "author": {
    "name": "Fleetify",
    "url": "https://github.com/fleetifydev"
  },
  "providers": [
    "claude",
    "codex",
    "gemini",
    "opencode",
    "cursor",
    "hermes",
    "github-copilot",
    "agy",
    "antigravity-sdk"
  ],
  "tags": [
    "data",
    "infrastructure"
  ],
  "icon": "https://api.iconify.design/logos:datadog.svg",
  "requires_secrets": [
    {
      "key": "DD_API_KEY",
      "label": "Datadog API key"
    },
    {
      "key": "DD_APP_KEY",
      "label": "Datadog Application key"
    },
    {
      "key": "DD_SITE",
      "label": "Datadog site (datadoghq.com / datadoghq.eu / …)"
    }
  ],
  "declares": {
    "mcp_servers": 1,
    "templates": 0,
    "workflows": 0,
    "prompts": 0,
    "providers": {}
  },
  "homepage": "https://github.com/fleetifydev/marketplace/tree/main/datadog",
  "license": "MIT"
}
