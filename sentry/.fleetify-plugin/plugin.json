{
  "name": "sentry",
  "display_name": "Sentry",
  "version": "0.1.1",
  "description": "Browse error groups, fetch stack traces, triage issues from Sentry.",
  "author": {
    "name": "Fleetify",
    "url": "https://github.com/fleetifydev"
  },
  "providers": [
    "claude-code",
    "codex-cli",
    "gemini-cli",
    "opencode",
    "cursor-cli",
    "hermes-agent",
    "github-copilot",
    "antigravity-cli",
    "antigravity-sdk",
    "grok-build"
  ],
  "tags": [
    "data"
  ],
  "icon": "https://api.iconify.design/logos:sentry-icon.svg",
  "requires_secrets": [
    {
      "key": "SENTRY_AUTH_TOKEN",
      "label": "Sentry auth token",
      "url": "https://sentry.io/settings/account/api/auth-tokens/"
    }
  ],
  "declares": {
    "mcp_servers": 1,
    "templates": 0,
    "workflows": 0,
    "prompts": 0,
    "providers": {}
  },
  "homepage": "https://github.com/fleetifydev/marketplace/tree/main/sentry",
  "license": "MIT"
}
